# Dominio com DNS A/AAAA apontando para a VPS
DOMAIN=jobs.seudominio.com
ACME_EMAIL=seu-email@example.com

# Arquivo privado carregado pelos containers. Nao versionar a copia sem `.example`.
PRODUCTION_ENV_FILE=./deploy/.env.production

# Banco interno: use uma senha longa e exclusiva
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=substitua_por_uma_senha_aleatoria_longa
POSTGRES_DB=jobhunter

# Dashboard privado
AUTH_PASSWORD=substitua_por_uma_senha_forte
AUTH_SECRET=substitua_por_um_segredo_aleatorio_com_32_ou_mais_caracteres
AUTH_LOGIN_RATE_LIMIT=5
API_READ_RATE_LIMIT=120
API_WRITE_RATE_LIMIT=30
TRUST_PROXY=true

# Comece em modo seguro. Copie as demais credenciais necessarias do `.env.example` raiz.
DRY_RUN=true
APPLICATION_MODE=OBSERVE
EXTERNAL_ACTIONS_KILL_SWITCH=true
ALLOW_EXTERNAL_EMAIL_SEND=false
MAX_APPLICATIONS_PER_DAY=0
ENABLE_IMAP=false
ENABLE_GITHUB_SCRAPER=false
ENABLE_LINKEDIN_SCRAPER=false
ENABLE_ATS_CONNECTORS=false
ENABLE_JOB_PROCESSING=false
ENABLE_FOLLOWUP_DRAFTS=false

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
