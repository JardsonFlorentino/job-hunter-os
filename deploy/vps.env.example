# Banco exclusivo na rede Docker. Use uma senha hexadecimal longa.
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=substitua_por_uma_senha_hexadecimal_longa
POSTGRES_DB=jobhunter
DATABASE_URL=postgresql://jobhunter:substitua_pela_mesma_senha@postgres:5432/jobhunter?schema=public

# Dashboard privado
AUTH_PASSWORD=substitua_por_uma_senha_forte
AUTH_SECRET=substitua_por_um_segredo_aleatorio_com_32_ou_mais_caracteres
AUTH_LOGIN_RATE_LIMIT=5
API_READ_RATE_LIMIT=120
API_WRITE_RATE_LIMIT=30
TRUST_PROXY=true

# IA
AI_PROVIDER=groq
# GROQ_API_KEY=adicione_quando_habilitar_o_processamento
GROQ_MODEL=openai/gpt-oss-20b
# OPENROUTER_API_KEY=adicione_somente_se_usar_openrouter
OPENROUTER_MODEL=google/gemini-3.7-flash

# E-mail: deixe credenciais ausentes no primeiro deploy em modo OBSERVE
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER=adicione_quando_habilitar_email
# SMTP_PASSWORD=adicione_quando_habilitar_email
SMTP_FROM_NAME="Jardson Florentino"
# SMTP_FROM_EMAIL=adicione_quando_habilitar_email
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
# IMAP_USER=adicione_quando_habilitar_imap
# IMAP_PASSWORD=adicione_quando_habilitar_imap

# Primeiro deploy obrigatoriamente seguro
DRY_RUN=true
APPLICATION_MODE=OBSERVE
EXTERNAL_ACTIONS_KILL_SWITCH=true
ALLOW_EXTERNAL_EMAIL_SEND=false
MAX_APPLICATIONS_PER_DAY=0
MIN_AUTO_EMAIL_SCORE=85
AUTO_EMAIL_COMPANY_ALLOWLIST=
ENABLE_IMAP=false
ENABLE_GITHUB_SCRAPER=false
ENABLE_LINKEDIN_SCRAPER=false
ENABLE_ATS_CONNECTORS=false
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
SMARTRECRUITERS_COMPANIES=
WORKABLE_ACCOUNTS=
ENABLE_JOB_PROCESSING=false
ENABLE_FOLLOWUP_DRAFTS=false
