# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=substitua_por_uma_senha_segura
POSTGRES_DB=jobhunter
POSTGRES_PORT=5432
BIND_ADDRESS=127.0.0.1
DATABASE_URL="postgresql://admin:substitua_por_uma_senha_segura@localhost:5432/jobhunter?schema=public"

# Acesso privado ao dashboard (AUTH_SECRET deve ter 32+ caracteres aleatorios)
AUTH_PASSWORD=substitua_por_uma_senha_forte
AUTH_SECRET=substitua_por_um_segredo_aleatorio_com_32_ou_mais_caracteres
AUTH_LOGIN_RATE_LIMIT=5
API_READ_RATE_LIMIT=120
API_WRITE_RATE_LIMIT=30
TRUST_PROXY=false

# IA (Groq por padrao; OpenRouter como fallback)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash

# SMTP — envio de candidaturas
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@example.com
SMTP_PASSWORD=substitua_pela_senha_de_aplicativo
SMTP_FROM_NAME="Seu Nome"
SMTP_FROM_EMAIL=seu-email@example.com

# IMAP — leitura da caixa de entrada
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=seu-email@example.com
IMAP_PASSWORD=substitua_pela_senha_de_aplicativo

# Padrao fail-closed
DRY_RUN=true
APPLICATION_MODE=OBSERVE
EXTERNAL_ACTIONS_KILL_SWITCH=true
ALLOW_EXTERNAL_EMAIL_SEND=false
MAX_APPLICATIONS_PER_DAY=0
MIN_AUTO_EMAIL_SCORE=85
AUTO_EMAIL_COMPANY_ALLOWLIST=
ENABLE_IMAP=false
ENABLE_GITHUB_SCRAPER=false
ENABLE_LINKEDIN_SCRAPER=false
ENABLE_ATS_CONNECTORS=false
ENABLE_JOB_PROCESSING=false
ENABLE_FOLLOWUP_DRAFTS=false
