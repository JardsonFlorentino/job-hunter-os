NODE_ENV=development
DATABASE_URL="postgresql://admin:substitua_por_uma_senha_segura@localhost:5432/jobhunter?schema=public"

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME="Seu Nome"
SMTP_FROM_EMAIL=seu-email@gmail.com

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=seu-email@gmail.com
IMAP_PASSWORD=
IMAP_SINCE_DATE=2026-08-28
IMAP_BATCH_SIZE=50

DRY_RUN=true
APPLICATION_MODE=OBSERVE
EXTERNAL_ACTIONS_KILL_SWITCH=true
ALLOW_EXTERNAL_EMAIL_SEND=false
MAX_APPLICATIONS_PER_DAY=0
MIN_AUTO_EMAIL_SCORE=85
AUTO_EMAIL_COMPANY_ALLOWLIST=
ENABLE_IMAP=false
ENABLE_GITHUB_SCRAPER=false
ENABLE_LINKEDIN_SCRAPER=false
ENABLE_ATS_CONNECTORS=false
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
SMARTRECRUITERS_COMPANIES=
WORKABLE_ACCOUNTS=
ENABLE_JOB_PROCESSING=false
ENABLE_FOLLOWUP_DRAFTS=false
